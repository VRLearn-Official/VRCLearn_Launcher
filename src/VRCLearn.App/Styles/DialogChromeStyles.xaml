<ResourceDictionary
    x:Class="VRCLearn.App.Styles.DialogChromeStyles"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:views="clr-namespace:VRCLearn.App.Views">

    <Style x:Key="PluginWindowStyle" TargetType="{x:Type ui:FluentWindow}" BasedOn="{StaticResource {x:Type ui:FluentWindow}}">
        <Setter Property="ResizeMode" Value="CanResize" />
        <Setter Property="ShowInTaskbar" Value="True" />
        <Setter Property="WindowBackdropType" Value="Mica" />
        <Setter Property="ExtendsContentIntoTitleBar" Value="True" />
        <Setter Property="MinWidth" Value="360" />
        <Setter Property="MinHeight" Value="260" />
    </Style>

    <Style x:Key="DialogChromeStyle" TargetType="{x:Type views:DialogChrome}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type views:DialogChrome}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="44" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0" Background="Transparent">
                            <TextBlock
                                Margin="16,0,0,0"
                                VerticalAlignment="Center"
                                FontWeight="SemiBold"
                                Text="{Binding Title, RelativeSource={RelativeSource AncestorType=Window}}"
                                Visibility="{Binding ShowTitle, RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource BooleanToVisibilityConverter}}" />
                            <ui:Button
                                Click="OnCloseClick"
                                Style="{StaticResource DialogCloseButton}"
                                Visibility="{Binding ShowClose, RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource BooleanToVisibilityConverter}}" />
                        </Grid>

                        <ContentPresenter Grid.Row="1" />
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
