<UserControl
    x:Class="VRCLearn.App.Views.PluginCard"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:markup="clr-namespace:VRCLearn.App.Markup"
    Height="222">

    <ui:Card
        Margin="0,0,12,12"
        Padding="10"
        HorizontalContentAlignment="Stretch"
        VerticalAlignment="Stretch"
        VerticalContentAlignment="Stretch"
        ToolTip="{Binding ErrorText}"
        ToolTipService.IsEnabled="{Binding HasError}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Grid
                    Width="32"
                    Height="32"
                    Margin="0,0,10,0"
                    VerticalAlignment="Top">
                    <ui:SymbolIcon
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        FontSize="24"
                        Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                        Symbol="PuzzlePiece24"
                        Visibility="{Binding HasIcon, Converter={StaticResource InverseBooleanToVisibilityConverter}}" />
                    <Image
                        Source="{Binding Icon}"
                        Stretch="Uniform"
                        Visibility="{Binding HasIcon, Converter={StaticResource BooleanToVisibilityConverter}}" />
                </Grid>

                <StackPanel Grid.Column="1">
                    <TextBlock
                        Style="{StaticResource RowTitle}"
                        Text="{Binding Name}"
                        TextTrimming="CharacterEllipsis" />
                    <StackPanel
                        Margin="{StaticResource Gap.Tight}"
                        Orientation="Horizontal"
                        Visibility="{Binding HasMeta, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <TextBlock Style="{StaticResource Caption}" Text="{Binding VersionText}" />
                        <TextBlock Style="{StaticResource Caption}" Text=" · " />
                        <TextBlock
                            Style="{StaticResource Caption}"
                            Visibility="{Binding HasSource, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <Hyperlink
                                Command="{Binding OpenSourceCommand}"
                                Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}"
                                ToolTip="{Binding SourceUrl}">
                                <Run Text="{Binding SourceText, Mode=OneWay}" />
                            </Hyperlink>
                        </TextBlock>
                        <TextBlock
                            Style="{StaticResource Caption}"
                            Text="{Binding SourceText}"
                            Visibility="{Binding HasSource, Converter={StaticResource InverseBooleanToVisibilityConverter}}" />
                    </StackPanel>
                </StackPanel>
            </Grid>

            <StackPanel Grid.Row="1">
                <TextBlock
                    MaxHeight="40"
                    Margin="{StaticResource Gap.Tight}"
                    Style="{StaticResource Caption}"
                    Text="{Binding Description}"
                    TextTrimming="CharacterEllipsis"
                    TextWrapping="Wrap" />

                <TextBlock
                    MaxHeight="36"
                    Margin="{StaticResource Gap.Tight}"
                    Text="{Binding StatusText}"
                    TextTrimming="CharacterEllipsis"
                    TextWrapping="Wrap"
                    Visibility="{Binding HasStatus, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <TextBlock.Style>
                        <Style BasedOn="{StaticResource Caption}" TargetType="TextBlock">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsError}" Value="True">
                                    <Setter Property="Foreground" Value="{DynamicResource SystemFillColorCriticalBrush}" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding IsWarning}" Value="True">
                                    <Setter Property="Foreground" Value="{DynamicResource SystemFillColorCautionBrush}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </StackPanel>

            <Grid Grid.Row="2" Margin="{StaticResource Gap.Row}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <ui:ToggleSwitch
                    VerticalAlignment="Center"
                    IsChecked="{Binding IsEnabled, Mode=TwoWay}"
                    IsEnabled="{Binding CanToggle}"
                    ToolTip="{markup:Tr Plugins.ToggleHint}" />

                <StackPanel
                    Grid.Column="1"
                    HorizontalAlignment="Right"
                    Orientation="Horizontal">
                    <ui:Button
                        Margin="{StaticResource Gap.Inline}"
                        Padding="4"
                        Appearance="Transparent"
                        BorderThickness="0"
                        Command="{Binding UpdateCommand}"
                        IsEnabled="{Binding CanUpdate}"
                        ToolTip="{Binding UpdateToolTip}"
                        Visibility="{Binding HasUpdate, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <ui:SymbolIcon
                            FontSize="{StaticResource IconSize.Inline}"
                            Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}"
                            Symbol="ArrowSync24" />
                    </ui:Button>
                    <ui:Button
                        Margin="{StaticResource Gap.Inline}"
                        Padding="4"
                        Appearance="Transparent"
                        BorderThickness="0"
                        Command="{Binding OpenDataCommand}"
                        IsEnabled="{Binding CanOpenData}"
                        ToolTip="{markup:Tr Plugins.OpenData}">
                        <ui:SymbolIcon FontSize="{StaticResource IconSize.Inline}" Symbol="FolderOpen24" />
                    </ui:Button>
                    <ui:Button
                        Margin="{StaticResource Gap.Inline}"
                        Padding="4"
                        Appearance="Transparent"
                        BorderThickness="0"
                        Command="{Binding UninstallCommand}"
                        IsEnabled="{Binding CanUninstall}"
                        ToolTip="{markup:Tr Plugins.Uninstall}">
                        <ui:SymbolIcon
                            FontSize="{StaticResource IconSize.Inline}"
                            Foreground="{DynamicResource SystemFillColorCriticalBrush}"
                            Symbol="Delete24" />
                    </ui:Button>
                    <ui:Button
                        Margin="{StaticResource Gap.Inline}"
                        Appearance="Primary"
                        Command="{Binding OpenCommand}"
                        Content="{markup:Tr Plugins.Open}"
                        IsEnabled="{Binding CanOpen}" />
                </StackPanel>
            </Grid>
        </Grid>
    </ui:Card>
</UserControl>
