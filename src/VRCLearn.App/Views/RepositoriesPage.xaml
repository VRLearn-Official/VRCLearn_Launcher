<UserControl
    x:Class="VRCLearn.App.Views.RepositoriesPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:markup="clr-namespace:VRCLearn.App.Markup">

    <ScrollViewer
        Style="{StaticResource PageScroll}"
        AllowDrop="True"
        DragOver="OnPageDragOver">
        <StackPanel>

            <DockPanel Margin="{StaticResource Gap.Field}">
                <ui:Button
                    DockPanel.Dock="Right"
                    Margin="{StaticResource Gap.Inline}"
                    Appearance="Primary"
                    Command="{Binding AddCommand}"
                    Content="{markup:Tr Repositories.Add}" />
                <ui:TextBox
                    PlaceholderText="{markup:Tr Repositories.UrlPlaceholder}"
                    Text="{Binding NewRepositoryUrl, UpdateSourceTrigger=PropertyChanged}" />
            </DockPanel>

            <StackPanel Style="{StaticResource Toolbar}">
                <ui:Button
                    Style="{StaticResource ToolbarButton}"
                    Appearance="Secondary"
                    Command="{Binding ImportCommand}"
                    Content="{markup:Tr Repositories.ImportTitle}" />
                <ui:Button
                    Style="{StaticResource ToolbarButton}"
                    Appearance="Secondary"
                    Click="OnExportClick"
                    Content="{markup:Tr Repositories.Export}" />
                <ui:Button
                    Style="{StaticResource ToolbarButton}"
                    Appearance="Secondary"
                    Command="{Binding RefreshCommand}"
                    Content="{markup:Tr Repositories.Refresh}" />
                <ui:ProgressRing Margin="4,0,0,0" Style="{StaticResource BusyRing}" />
            </StackPanel>

            <TextBlock Style="{StaticResource SectionTitle}" Text="{markup:Tr Repositories.List}" />

            <TextBlock
                Margin="{StaticResource Gap.Row}"
                Style="{StaticResource Caption}"
                Text="{markup:Tr Repositories.Empty}"
                Visibility="{Binding HasRepositories, Converter={StaticResource InverseBooleanToVisibilityConverter}}" />

            <ItemsControl Margin="{StaticResource Gap.Row}" ItemsSource="{Binding Repositories}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel
                                    AllowDrop="True"
                                    Background="Transparent"
                                    DragOver="OnRowDragOver"
                                    Drop="OnRowDrop"
                                    MouseLeftButtonUp="OnRowMouseUp"
                                    MouseMove="OnRowMouseMove">
                                    <Border
                                        x:Name="SlotAbove"
                                        Height="2"
                                        Background="{DynamicResource AccentFillColorDefaultBrush}"
                                        Opacity="0" />

                                    <ui:Card x:Name="RowSurface">
                                        <ui:Card.Style>
                                            <Style BasedOn="{StaticResource RowCard}" TargetType="ui:Card">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsHidden}" Value="True">
                                                        <Setter Property="Opacity" Value="0.45" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding IsDragging}" Value="True">
                                                        <Setter Property="Opacity" Value="0.4" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </ui:Card.Style>

                                    <Grid
                                        x:Name="RowContent"
                                        Background="Transparent">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <Border
                                            Grid.Column="0"
                                            Margin="0,0,12,0"
                                            Padding="6,2"
                                            VerticalAlignment="Center"
                                            Background="Transparent"
                                            Cursor="SizeAll"
                                            MouseLeftButtonDown="OnHandleMouseDown">
                                            <TextBlock
                                                FontSize="16"
                                                IsHitTestVisible="False"
                                                Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                Text="≡" />
                                        </Border>

                                        <StackPanel
                                            Grid.Column="1"
                                            VerticalAlignment="Center"
                                            IsHitTestVisible="False">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Style="{StaticResource RowTitle}" Text="{Binding Title}" />
                                                <Border
                                                    Margin="{StaticResource Gap.Inline}"
                                                    Padding="6,1"
                                                    VerticalAlignment="Center"
                                                    Background="{DynamicResource ControlFillColorSecondaryBrush}"
                                                    CornerRadius="{StaticResource Radius.Control}"
                                                    Visibility="{Binding IsHidden, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                    <TextBlock
                                                        FontSize="{StaticResource FontSize.Caption}"
                                                        Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                        Text="{markup:Tr Repositories.Hidden}" />
                                                </Border>
                                            </StackPanel>

                                            <TextBlock
                                                Margin="{StaticResource Gap.Tight}"
                                                Style="{StaticResource Caption}"
                                                Text="{Binding Details}" />
                                            <TextBlock Style="{StaticResource Caption}" Text="{Binding Summary}" />
                                        </StackPanel>

                                        <StackPanel Grid.Column="2" Style="{StaticResource RowActions}">
                                            <ui:Button
                                                Style="{StaticResource RowButton}"
                                                Margin="0,0,0,0"
                                                Appearance="Secondary"
                                                Command="{markup:RowCommand ToggleHiddenCommand}"
                                                CommandParameter="{Binding}"
                                                Content="{Binding HideAction}" />
                                            <ui:Button
                                                Style="{StaticResource RowButton}"
                                                Appearance="Secondary"
                                                Command="{markup:RowCommand RemoveCommand}"
                                                CommandParameter="{Binding}"
                                                Content="{markup:Tr Repositories.Remove}" />
                                        </StackPanel>
                                    </Grid>
                                    </ui:Card>

                                    <Border
                                        x:Name="SlotBelow"
                                        Height="2"
                                        Background="{DynamicResource AccentFillColorDefaultBrush}"
                                        Opacity="0" />
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

            <TextBlock Style="{StaticResource SectionTitle}" Text="{markup:Tr Packages.User.Title}" />

            <Grid Margin="{StaticResource Gap.Row}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Style="{StaticResource Caption}" Text="{markup:Tr Packages.User.Hint}" />
                <StackPanel
                    Grid.Column="1"
                    VerticalAlignment="Center"
                    Orientation="Horizontal">
                    <CheckBox
                        VerticalAlignment="Center"
                        Content="{markup:Tr Packages.User.Hide}"
                        IsChecked="{Binding UserPackages.HideUserPackages}" />
                    <ui:Button
                        Margin="12,0,0,0"
                        Appearance="Secondary"
                        Click="OnAddUserPackageClick"
                        Content="{markup:Tr Packages.User.Add}" />
                </StackPanel>
            </Grid>

            <TextBlock
                Margin="{StaticResource Gap.Small}"
                Style="{StaticResource Caption}"
                Text="{markup:Tr Packages.User.None}"
                Visibility="{Binding UserPackages.HasNoFolders, Converter={StaticResource BooleanToVisibilityConverter}}" />

            <ItemsControl Margin="{StaticResource Gap.Row}" ItemsSource="{Binding UserPackages.Folders}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <ui:Card Style="{StaticResource RowCard}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <ui:SymbolIcon
                                    VerticalAlignment="Center"
                                    FontSize="{StaticResource IconSize.Inline}"
                                    Foreground="{DynamicResource SystemFillColorCautionBrush}"
                                    Symbol="Warning24"
                                    Visibility="{Binding IsUnreadable, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                <StackPanel Grid.Column="1" Margin="{StaticResource Gap.Inline}">
                                    <TextBlock FontSize="{StaticResource FontSize.Caption}" Text="{Binding DisplayName}" TextWrapping="Wrap" />
                                    <TextBlock
                                        FontFamily="Consolas"
                                        FontSize="{StaticResource FontSize.Caption}"
                                        Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                        Text="{Binding Path}"
                                        TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                                <ui:Button
                                    Grid.Column="2"
                                    Style="{StaticResource RowButton}"
                                    Appearance="Secondary"
                                    Command="{markup:RowCommand UserPackages.RemoveCommand}"
                                    CommandParameter="{Binding}"
                                    Content="{markup:Tr Repositories.Remove}" />
                            </Grid>
                        </ui:Card>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </ScrollViewer>
</UserControl>
