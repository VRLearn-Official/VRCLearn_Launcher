<UserControl
    x:Class="VRCLearn.App.Views.SetupPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:markup="clr-namespace:VRCLearn.App.Markup">

    <UserControl.Resources>
        <markup:StepVisibilityConverter x:Key="StepVisibility" />

        <Style x:Key="StepHeading" TargetType="TextBlock">
            <Setter Property="FontSize" Value="{StaticResource FontSize.Step}" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>

        <Style x:Key="StepCaption" TargetType="TextBlock">
            <Setter Property="Margin" Value="{StaticResource Gap.Row}" />
            <Setter Property="FontSize" Value="{StaticResource FontSize.Body}" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="LineHeight" Value="20" />
            <Setter Property="LineStackingStrategy" Value="BlockLineHeight" />
        </Style>
    </UserControl.Resources>

    <Grid Margin="{StaticResource PagePadding}">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ScrollViewer
            x:Name="Scroller"
            Grid.Row="0"
            VerticalContentAlignment="Top"
            VerticalScrollBarVisibility="Auto"
            markup:SmoothScroll.IsEnabled="True">
            <StackPanel
                Width="760"
                HorizontalAlignment="Center"
                VerticalAlignment="Top">

                <TextBlock Style="{StaticResource StepCaption}" Text="{Binding StepCaption}" />

                <ui:Card Margin="{StaticResource Gap.Large}" Padding="32">
                    <Grid x:Name="Steps">

                        <StackPanel Visibility="{Binding Step, Converter={StaticResource StepVisibility}, ConverterParameter=0}">
                            <TextBlock Style="{StaticResource StepHeading}" Text="{markup:Tr Setup.Appearance}" />
                            <TextBlock
                                Style="{StaticResource StepCaption}"
                                Text="{markup:Tr Setup.AppearanceHint}" />

                            <HeaderedContentControl
                                Margin="{StaticResource Gap.Large}"
                                Header="{markup:Tr Settings.Language}"
                                Style="{StaticResource FieldRow}">
                                <ComboBox
                                    MinWidth="260"
                                    DisplayMemberPath="Display"
                                    ItemsSource="{Binding Shared.Languages}"
                                    SelectedValue="{Binding Shared.SelectedLanguage}"
                                    SelectedValuePath="Value" />
                            </HeaderedContentControl>

                            <HeaderedContentControl
                                Margin="{StaticResource Gap.Large}"
                                Header="{markup:Tr Settings.Theme}"
                                Style="{StaticResource FieldRow}">
                                <ComboBox
                                    MinWidth="260"
                                    DisplayMemberPath="Display"
                                    ItemsSource="{Binding Shared.Themes}"
                                    SelectedValue="{Binding Shared.SelectedTheme}"
                                    SelectedValuePath="Value" />
                            </HeaderedContentControl>
                        </StackPanel>

                        <StackPanel Visibility="{Binding Step, Converter={StaticResource StepVisibility}, ConverterParameter=1}">
                            <TextBlock Style="{StaticResource StepHeading}" Text="{markup:Tr Setup.Locations}" />
                            <TextBlock
                                Style="{StaticResource StepCaption}"
                                Text="{markup:Tr Setup.LocationsHint}" />

                            <TextBlock
                                Margin="{StaticResource Gap.Large}"
                                Style="{StaticResource RowTitle}"
                                Text="{markup:Tr Settings.ProjectPath}" />
                            <TextBlock
                                Margin="{StaticResource Gap.Small}"
                                FontSize="{StaticResource FontSize.Body}"
                                Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                Text="{markup:Tr Settings.ProjectPathHint}"
                                TextWrapping="Wrap" />

                            <DockPanel Margin="{StaticResource Gap.Large}" Style="{StaticResource BrowseRow}">
                                <ui:Button
                                    DockPanel.Dock="Right"
                                    Click="OnBrowseProjectDirectoryClick"
                                    Content="{markup:Tr Templates.Browse}"
                                    Style="{StaticResource BrowseButton}" />
                                <ui:TextBox
                                    Style="{StaticResource PathTextBox}"
                                    Text="{Binding Shared.ProjectDirectory, Mode=OneWay}" />
                            </DockPanel>

                            <TextBlock
                                Margin="{StaticResource Gap.Large}"
                                Style="{StaticResource RowTitle}"
                                Text="{markup:Tr Settings.BackupDirectory}" />
                            <TextBlock
                                Margin="{StaticResource Gap.Small}"
                                FontSize="{StaticResource FontSize.Body}"
                                Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                Text="{markup:Tr Settings.BackupDirectoryHint}"
                                TextWrapping="Wrap" />

                            <DockPanel Margin="{StaticResource Gap.Large}" Style="{StaticResource BrowseRow}">
                                <ui:Button
                                    DockPanel.Dock="Right"
                                    Click="OnBrowseBackupDirectoryClick"
                                    Content="{markup:Tr Templates.Browse}"
                                    Style="{StaticResource BrowseButton}" />
                                <ui:TextBox
                                    Style="{StaticResource PathTextBox}"
                                    Text="{Binding Shared.BackupDirectory, Mode=OneWay}" />
                            </DockPanel>

                            <HeaderedContentControl Margin="{StaticResource Gap.Large}" Style="{StaticResource FieldRow}">
                                <HeaderedContentControl.Header>
                                    <StackPanel>
                                        <TextBlock Text="{markup:Tr Settings.UseForVccProtocol}" />
                                        <TextBlock
                                            Margin="{StaticResource Gap.Small}"
                                            FontSize="{StaticResource FontSize.Body}"
                                            Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                            Text="{markup:Tr Settings.UseForVccProtocolHint}"
                                            TextWrapping="Wrap" />
                                    </StackPanel>
                                </HeaderedContentControl.Header>
                                <ui:ToggleSwitch IsChecked="{Binding Shared.UseForVccProtocol}" />
                            </HeaderedContentControl>
                        </StackPanel>

                    </Grid>
                </ui:Card>
            </StackPanel>
        </ScrollViewer>

        <Grid
            Grid.Row="1"
            Width="760"
            Margin="{StaticResource Gap.Large}"
            HorizontalAlignment="Center">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <ui:Button
                Grid.Column="0"
                MinWidth="128"
                HorizontalAlignment="Left"
                Appearance="Secondary"
                Command="{Binding BackCommand}"
                Content="{markup:Tr Setup.Back}"
                IsEnabled="{Binding CanGoBack}" />

            <StackPanel
                Grid.Column="1"
                HorizontalAlignment="Right"
                Orientation="Horizontal">
                <ui:Button
                    MinWidth="128"
                    Appearance="Secondary"
                    Command="{Binding CancelCommand}"
                    Content="{markup:Tr Dialog.Cancel}"
                    Visibility="{Binding IsRerun, Converter={StaticResource BooleanToVisibilityConverter}}" />
                <ui:Button
                    MinWidth="128"
                    Margin="12,0,0,0"
                    Appearance="Primary"
                    Command="{Binding NextCommand}"
                    Content="{markup:Tr Setup.Next}"
                    Visibility="{Binding IsNotLastStep, Converter={StaticResource BooleanToVisibilityConverter}}" />
                <ui:Button
                    MinWidth="128"
                    Margin="12,0,0,0"
                    Appearance="Primary"
                    Command="{Binding FinishCommand}"
                    Content="{markup:Tr Setup.Finish}"
                    Visibility="{Binding IsLastStep, Converter={StaticResource BooleanToVisibilityConverter}}" />

            </StackPanel>
        </Grid>
    </Grid>
</UserControl>
