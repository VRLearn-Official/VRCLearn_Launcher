<views:DialogWindowBase
    x:Class="VRCLearn.App.Views.BackupOptionsDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:markup="clr-namespace:VRCLearn.App.Markup"
    xmlns:views="clr-namespace:VRCLearn.App.Views"
    Width="480"
    WindowStartupLocation="CenterOwner"
    Style="{StaticResource DialogWindow}">

    <views:DialogChrome Style="{StaticResource DialogChromeStyle}">

        <StackPanel Margin="20,0,20,16">
            <CheckBox
                x:Name="IncludeLibraryBox"
                Margin="{StaticResource Gap.Small}"
                Content="{markup:Tr Backups.Options.Library}"
                IsChecked="True" />

            <Border
                Margin="{StaticResource Gap.Small}"
                Padding="12"
                Background="{DynamicResource ControlFillColorSecondaryBrush}"
                BorderBrush="{DynamicResource SystemFillColorCautionBrush}"
                BorderThickness="1"
                CornerRadius="{StaticResource Radius.Control}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <ui:SymbolIcon
                        Margin="0,1,10,0"
                        VerticalAlignment="Top"
                        FontSize="20"
                        Foreground="{DynamicResource SystemFillColorCautionBrush}"
                        Symbol="Warning24" />

                    <TextBlock
                        Grid.Column="1"
                        Text="{markup:Tr Backups.Options.Warning}"
                        TextWrapping="Wrap" />
                </Grid>
            </Border>

            <TextBlock
                Margin="{StaticResource Gap.Row}"
                FontWeight="SemiBold"
                Text="{markup:Tr Backups.Note}" />

            <ui:TextBox x:Name="NoteBox" MaxLength="200" />

            <StackPanel Style="{StaticResource DialogRow}">
                <ui:Button
                    x:Name="ConfirmButton"
                    Appearance="Primary"
                    Click="OnConfirmClick"
                    Style="{StaticResource DialogButton}" />
            </StackPanel>
        </StackPanel>
    </views:DialogChrome>
</views:DialogWindowBase>
