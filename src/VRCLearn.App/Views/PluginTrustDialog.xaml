<views:DialogWindowBase
    x:Class="VRCLearn.App.Views.PluginTrustDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:views="clr-namespace:VRCLearn.App.Views"
    xmlns:markup="clr-namespace:VRCLearn.App.Markup"
    Width="560"
    WindowStartupLocation="CenterOwner"
    Style="{StaticResource DialogWindow}">

    <views:DialogChrome Style="{StaticResource DialogChromeStyle}" ShowTitle="False">
        <StackPanel Margin="20,0,20,16">
            <TextBlock
                x:Name="TitleText"
                FontSize="{StaticResource FontSize.Section}"
                FontWeight="SemiBold"
                TextWrapping="Wrap" />

            <TextBlock
                Margin="{StaticResource Gap.Tight}"
                Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                Text="{markup:Tr Plugins.Trust.Subtitle}"
                TextWrapping="Wrap" />

            <Border
                Margin="{StaticResource Gap.Small}"
                Padding="12"
                Background="{DynamicResource ControlFillColorSecondaryBrush}"
                BorderBrush="{DynamicResource SystemFillColorCautionBrush}"
                BorderThickness="1"
                CornerRadius="{StaticResource Radius.Control}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <ui:SymbolIcon
                        Margin="0,1,10,0"
                        VerticalAlignment="Top"
                        FontSize="20"
                        Foreground="{DynamicResource SystemFillColorCautionBrush}"
                        Symbol="Warning24" />

                    <StackPanel Grid.Column="1">
                        <TextBlock
                            FontWeight="SemiBold"
                            Text="{markup:Tr Plugins.Trust.WarningTitle}" />
                        <TextBlock
                            x:Name="WarningText"
                            Margin="{StaticResource Gap.Tight}"
                            FontSize="{StaticResource FontSize.Body}"
                            TextWrapping="Wrap" />
                    </StackPanel>
                </Grid>
            </Border>

            <TextBlock
                Margin="{StaticResource Gap.Field}"
                FontWeight="SemiBold"
                Text="{markup:Tr Plugins.Trust.DetailsTitle}" />

            <Border
                Margin="{StaticResource Gap.Small}"
                Padding="14"
                Background="{DynamicResource ControlFillColorSecondaryBrush}"
                BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="{StaticResource Radius.Control}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" MinWidth="80" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBlock
                        Grid.Row="0"
                        Margin="0,0,12,8"
                        Style="{StaticResource Caption}"
                        Text="{markup:Tr Plugins.Trust.NameLabel}" />
                    <TextBlock
                        x:Name="NameText"
                        Grid.Row="0"
                        Grid.Column="1"
                        Margin="0,0,0,8"
                        FontSize="{StaticResource FontSize.Body}"
                        FontWeight="SemiBold"
                        TextWrapping="Wrap" />

                    <TextBlock
                        Grid.Row="1"
                        Margin="0,0,12,8"
                        Style="{StaticResource Caption}"
                        Text="{markup:Tr Plugins.Trust.IdLabel}" />
                    <TextBlock
                        x:Name="IdText"
                        Grid.Row="1"
                        Grid.Column="1"
                        Margin="0,0,0,8"
                        FontSize="{StaticResource FontSize.Body}"
                        FontWeight="SemiBold"
                        TextWrapping="Wrap" />

                    <TextBlock
                        Grid.Row="2"
                        Margin="0,0,12,8"
                        Style="{StaticResource Caption}"
                        Text="{markup:Tr Plugins.Trust.VersionLabel}" />
                    <TextBlock
                        x:Name="VersionText"
                        Grid.Row="2"
                        Grid.Column="1"
                        Margin="0,0,0,8"
                        FontSize="{StaticResource FontSize.Body}"
                        FontWeight="SemiBold"
                        TextWrapping="Wrap" />

                    <TextBlock
                        Grid.Row="3"
                        Margin="0,0,12,8"
                        Style="{StaticResource Caption}"
                        Text="{markup:Tr Plugins.Trust.SourceLabel}" />
                    <TextBlock
                        x:Name="SourceText"
                        Grid.Row="3"
                        Grid.Column="1"
                        Margin="0,0,0,8"
                        FontSize="{StaticResource FontSize.Body}"
                        FontWeight="SemiBold"
                        TextWrapping="Wrap" />

                    <TextBlock
                        Grid.Row="4"
                        Margin="0,0,12,0"
                        Style="{StaticResource Caption}"
                        Text="{markup:Tr Plugins.Trust.RequiresLabel}" />
                    <TextBlock
                        x:Name="RequiresText"
                        Grid.Row="4"
                        Grid.Column="1"
                        FontSize="{StaticResource FontSize.Body}"
                        TextWrapping="Wrap" />
                </Grid>
            </Border>

            <StackPanel Style="{StaticResource DialogRow}">
                <ui:Button
                    x:Name="CancelButton"
                    Click="OnCancelClick"
                    Style="{StaticResource DialogButton}" />
                <ui:Button
                    x:Name="InstallButton"
                    Margin="{StaticResource Gap.Inline}"
                    Appearance="Primary"
                    Click="OnInstallClick"
                    Style="{StaticResource DialogButton}" />
            </StackPanel>
        </StackPanel>
    </views:DialogChrome>
</views:DialogWindowBase>
