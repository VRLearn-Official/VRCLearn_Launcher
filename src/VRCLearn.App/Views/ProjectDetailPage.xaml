<UserControl
    x:Class="VRCLearn.App.Views.ProjectDetailPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:markup="clr-namespace:VRCLearn.App.Markup"
    xmlns:views="clr-namespace:VRCLearn.App.Views">

    <ScrollViewer Style="{StaticResource PageScroll}">
        <StackPanel>

            <WrapPanel Margin="{StaticResource Gap.Field}">
                <ui:Button
                    Margin="0,0,4,8"
                    Command="{Binding BackCommand}"
                    Icon="{ui:SymbolIcon ArrowLeft24}" />
                <ui:Button
                    Margin="{StaticResource Gap.Wrapped}"
                    Style="{StaticResource RefreshToolbarButton}"
                    Tag="{Binding RefreshCommand.IsRunning}"
                    Appearance="Secondary"
                    Command="{Binding RefreshCommand}"
                    Content="{markup:Tr ProjectDetail.Refresh}" />
                <ui:Button
                    Margin="{StaticResource Gap.Wrapped}"
                    Style="{StaticResource ToolbarButton}"
                    Appearance="Secondary"
                    Command="{Binding OpenFolderCommand}"
                    Content="{markup:Tr ProjectDetail.OpenFolder}"
                    Icon="{ui:SymbolIcon FolderOpen24}" />
                <ui:Button
                    Margin="{StaticResource Gap.Wrapped}"
                    Style="{StaticResource ToolbarButton}"
                    Appearance="Secondary"
                    Command="{Binding BackupCommand}"
                    Content="{markup:Tr ProjectDetail.Backup}"
                    Icon="{ui:SymbolIcon Archive24}" />
                <ui:Button
                    Margin="{StaticResource Gap.Wrapped}"
                    Style="{StaticResource ToolbarButton}"
                    Appearance="Secondary"
                    Command="{Binding CopyCommand}"
                    Content="{markup:Tr ProjectDetail.Copy}"
                    Icon="{ui:SymbolIcon Copy24}" />
                <ui:Button
                    Margin="{StaticResource Gap.Wrapped}"
                    Style="{StaticResource ToolbarButton}"
                    Appearance="Secondary"
                    Command="{Binding CreateTemplateCommand}"
                    Content="{markup:Tr ProjectDetail.CreateTemplate}"
                    Icon="{ui:SymbolIcon DocumentAdd24}" />
                <StackPanel Margin="{StaticResource Gap.Wrapped}" Orientation="Horizontal">
                    <ComboBox
                        MinWidth="150"
                        Margin="0,0,8,0"
                        VerticalAlignment="Center"
                        DisplayMemberPath="Display"
                        ItemsSource="{Binding InstalledEditors}"
                        SelectedItem="{Binding SelectedEditor}"
                        ToolTip="{Binding EditorCaption}"
                        Visibility="{Binding HasEditors, Converter={StaticResource BooleanToVisibilityConverter}}" />
                    <views:UnityActionButton
                        ButtonStyle="{StaticResource ToolbarButton}"
                        BringToFrontCommand="{Binding BringUnityToFrontCommand}"
                        IsUnityRunning="{Binding IsUnityRunning}"
                        LaunchCommand="{Binding OpenInUnityCommand}" />
                </StackPanel>
                <Grid Visibility="{Binding RefreshCommand.IsRunning, Converter={StaticResource InverseBooleanToVisibilityConverter}}">
                    <ui:ProgressRing Margin="4,0,0,8" Style="{StaticResource BusyRing}" />
                </Grid>
            </WrapPanel>

            <StackPanel Margin="{StaticResource Gap.Small}" Orientation="Horizontal">
                <ui:Button
                    Appearance="Secondary"
                    Command="{Binding InstallInUnityHubCommand}"
                    Content="{markup:Tr ProjectDetail.UnityInstallInHub}"
                    Visibility="{Binding HasUnityHubInstallLink, Converter={StaticResource BooleanToVisibilityConverter}}" />
            </StackPanel>

            <ui:InfoBar
                Margin="{StaticResource Gap.Row}"
                IsClosable="False"
                IsOpen="{Binding NeedsResolve, Mode=OneWay}"
                Message="{markup:Tr ProjectDetail.NeedsResolve}"
                Severity="Warning">
                <ui:Button
                    Margin="0,10,0,0"
                    HorizontalAlignment="Left"
                    Appearance="Primary"
                    Command="{Binding ResolveCommand}"
                    Content="{markup:Tr ProjectDetail.Resolve}" />
            </ui:InfoBar>

            <ui:Card
                Margin="{StaticResource Gap.Field}"
                Padding="{StaticResource Pad.CardRow}"
                Visibility="{Binding HasPendingCopy, Converter={StaticResource BooleanToVisibilityConverter}}">
                <StackPanel>
                    <TextBlock FontWeight="SemiBold" Text="{markup:Tr ProjectDetail.Copy.Title}" />
                    <TextBlock
                        Margin="{StaticResource Gap.Tight}"
                        Style="{StaticResource Caption}"
                        Text="{markup:Tr ProjectDetail.Copy.Hint}" />

                    <DockPanel Margin="{StaticResource Gap.Row}" Style="{StaticResource BrowseRow}">
                        <ui:Button
                            DockPanel.Dock="Right"
                            Click="OnBrowseCopyDestinationClick"
                            Content="{markup:Tr ProjectDetail.Browse}"
                            Style="{StaticResource BrowseButton}" />
                        <TextBox Text="{Binding CopyDestination, UpdateSourceTrigger=PropertyChanged}" TextWrapping="Wrap" />
                    </DockPanel>

                    <StackPanel Margin="{StaticResource Gap.Row}" Orientation="Horizontal">
                        <ui:Button
                            Appearance="Primary"
                            Command="{Binding ConfirmCopyCommand}"
                            Content="{markup:Tr ProjectDetail.Copy.Confirm}" />
                        <ui:Button
                            Margin="{StaticResource Gap.Inline}"
                            Appearance="Secondary"
                            Command="{Binding CancelCopyCommand}"
                            Content="{markup:Tr ProjectDetail.Cancel}" />
                    </StackPanel>
                </StackPanel>
            </ui:Card>

            <StackPanel Visibility="{Binding HasBackups, Converter={StaticResource BooleanToVisibilityConverter}}">
                <ToggleButton
                    Checked="OnBackupsChecked"
                    Cursor="Hand"
                    FocusVisualStyle="{x:Null}"
                    HorizontalContentAlignment="Stretch"
                    IsChecked="{Binding AreBackupsExpanded, Mode=TwoWay}"
                    Unchecked="OnBackupsUnchecked">
                    <ToggleButton.Template>
                        <ControlTemplate TargetType="ToggleButton">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" />
                        </ControlTemplate>
                    </ToggleButton.Template>
                    <Grid Margin="{StaticResource Gap.Section}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock
                            Margin="0"
                            Style="{StaticResource SectionTitle}"
                            Text="{markup:Tr ProjectDetail.Backups.Title}" />
                        <ui:SymbolIcon
                            Grid.Column="1"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center"
                            FontSize="{StaticResource IconSize.Inline}"
                            Foreground="{DynamicResource TextFillColorSecondaryBrush}">
                            <ui:SymbolIcon.Style>
                                <Style TargetType="ui:SymbolIcon">
                                    <Setter Property="Symbol" Value="ChevronDown24" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding AreBackupsExpanded}" Value="True">
                                            <Setter Property="Symbol" Value="ChevronUp24" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </ui:SymbolIcon.Style>
                        </ui:SymbolIcon>
                    </Grid>
                </ToggleButton>
                <StackPanel
                    x:Name="BackupsContent"
                    ClipToBounds="True"
                    Visibility="Collapsed">
                    <ItemsControl
                        MaxHeight="320"
                        Margin="{StaticResource Gap.Row}"
                        Style="{StaticResource VirtualizedItems}"
                        ItemsSource="{Binding Backups}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <ui:Card Style="{StaticResource MissingRowCard}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Grid VerticalAlignment="Center">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock
                                            VerticalAlignment="Center"
                                            Style="{StaticResource Caption}"
                                            Text="{Binding Display}"
                                            ToolTip="{Binding FileName}" />
                                        <TextBlock
                                            Grid.Column="1"
                                            Margin="{StaticResource Gap.Inline}"
                                            VerticalAlignment="Center"
                                            Style="{StaticResource CaptionDim}"
                                            Text="{Binding Note}"
                                            TextTrimming="CharacterEllipsis"
                                            ToolTip="{Binding Note}"
                                            Visibility="{Binding HasNote, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                    </Grid>
                                    <TextBlock
                                        Grid.Column="1"
                                        VerticalAlignment="Center"
                                        Style="{StaticResource Caption}"
                                        Text="{markup:Tr Backups.FileMoved}"
                                        Visibility="{Binding IsMissing, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                    <ui:Button
                                        Grid.Column="1"
                                        Appearance="Secondary"
                                        Command="{markup:RowCommand RestoreCommand}"
                                        CommandParameter="{Binding}"
                                        Content="{markup:Tr ProjectDetail.Restore}"
                                        Visibility="{Binding IsAvailable, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                </Grid>
                                </ui:Card>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </StackPanel>

            <TextBlock Style="{StaticResource SectionTitle}" Text="{markup:Tr ProjectDetail.Packages}" />

            <ui:Card Margin="0,10,0,0" Padding="16,10">
                <StackPanel Orientation="Horizontal">
                    <TextBlock
                        Margin="0,0,12,0"
                        VerticalAlignment="Center"
                        FontWeight="SemiBold"
                        Text="{markup:Tr ProjectDetail.Batch.Title}" />
                    <ui:Button
                        Style="{StaticResource RowButton}"
                        Appearance="Secondary"
                        Command="{Binding InstallSelectedCommand}"
                        Content="{markup:Tr ProjectDetail.Batch.Install}" />
                    <ui:Button
                        Style="{StaticResource RowButton}"
                        Appearance="Secondary"
                        Command="{Binding UpgradeSelectedCommand}"
                        Content="{markup:Tr ProjectDetail.Batch.Upgrade}" />
                    <ui:Button
                        Style="{StaticResource RowButton}"
                        Appearance="Secondary"
                        Command="{Binding ReinstallSelectedCommand}"
                        Content="{markup:Tr ProjectDetail.Batch.Reinstall}" />
                    <ui:Button
                        Style="{StaticResource RowButton}"
                        Appearance="Secondary"
                        Command="{Binding RemoveSelectedCommand}"
                        Content="{markup:Tr ProjectDetail.Batch.Remove}" />
                    <ui:Button
                        Style="{StaticResource RowButton}"
                        Appearance="Secondary"
                        Command="{Binding UpgradeAllCommand}"
                        Content="{markup:Tr ProjectDetail.Batch.UpgradeAll}" />
                    <ui:Button
                        Style="{StaticResource RowButton}"
                        Appearance="Secondary"
                        Command="{Binding ClearSelectionCommand}"
                        Content="{markup:Tr ProjectDetail.Batch.Clear}" />
                </StackPanel>
            </ui:Card>

            <ui:TextBox
                Margin="0,10,0,0"
                PlaceholderText="{markup:Tr ProjectDetail.SearchPlaceholder}"
                Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" />

            <ItemsControl Margin="{StaticResource Gap.Small}" ItemsSource="{Binding PackageView}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <ui:Card Style="{StaticResource RowCard}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <CheckBox
                                    Grid.Column="0"
                                    Margin="0,0,10,0"
                                    VerticalAlignment="Center"
                                    IsChecked="{Binding IsSelected}"
                                    Visibility="{Binding CanSelect, Converter={StaticResource BooleanToVisibilityConverter}}" />

                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock
                                            VerticalAlignment="Center"
                                            FontWeight="SemiBold"
                                            Text="{Binding DisplayName}"
                                            TextTrimming="CharacterEllipsis"
                                            ToolTip="{Binding DisplayName}" />
                                        <Border
                                            Margin="{StaticResource Gap.Inline}"
                                            Padding="6,1"
                                            VerticalAlignment="Center"
                                            Style="{StaticResource TagChip}"
                                            Visibility="{Binding IsCustom, Converter={StaticResource BooleanToVisibilityConverter}}">
                                            <TextBlock FontSize="{StaticResource FontSize.Caption}" Text="{markup:Tr ProjectDetail.CustomTag}" />
                                        </Border>
                                        <ui:SymbolIcon
                                            Margin="{StaticResource Gap.Inline}"
                                            VerticalAlignment="Center"
                                            FontSize="{StaticResource IconSize.Inline}"
                                            Foreground="{DynamicResource SystemFillColorCautionBrush}"
                                            Symbol="Warning24"
                                            ToolTip="{markup:Tr ProjectDetail.UnlockedHint}"
                                            Visibility="{Binding IsUnlocked, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                    </StackPanel>
                                    <TextBlock
                                        Margin="0,2,0,0"
                                        Style="{StaticResource Caption}"
                                        Text="{Binding Name}"
                                        TextTrimming="CharacterEllipsis"
                                        TextWrapping="NoWrap"
                                        ToolTip="{Binding Name}" />
                                </StackPanel>

                                <StackPanel Grid.Column="2" Style="{StaticResource RowActions}">
                                    <ui:Button
                                        Margin="0,0,10,0"
                                        Style="{StaticResource RowButton}"
                                        Appearance="Secondary"
                                        Click="OnUpgradeClick"
                                        Content="{Binding NewerVersion}"
                                        Icon="{ui:SymbolIcon ArrowCircleUp24}"
                                        ToolTip="{markup:Tr ProjectDetail.NewerAvailable}"
                                        Visibility="{Binding HasNewerVersion, Converter={StaticResource BooleanToVisibilityConverter}}" />

                                    <ComboBox
                                        MinWidth="110"
                                        VerticalAlignment="Center"
                                        IsEnabled="{Binding CanChooseVersion}"
                                        ItemsSource="{Binding AvailableVersions}"
                                        SelectedItem="{Binding SelectedVersion}"
                                        Visibility="{Binding HasVersions, Converter={StaticResource BooleanToVisibilityConverter}}" />

                                    <ui:Button
                                        Style="{StaticResource RowButton}"
                                        Appearance="Secondary"
                                        Command="{markup:RowCommand ReinstallCommand}"
                                        CommandParameter="{Binding}"
                                        Content="{markup:Tr ProjectDetail.Reinstall}"
                                        IsEnabled="{Binding CanReinstall}"
                                        Visibility="{Binding IsInstalled, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                    <ui:Button
                                        Style="{StaticResource RowButton}"
                                        Appearance="Secondary"
                                        Command="{markup:RowCommand RemoveCommand}"
                                        CommandParameter="{Binding}"
                                        Content="{markup:Tr ProjectDetail.Remove}"
                                        IsEnabled="{Binding CanRemove}"
                                        Visibility="{Binding IsInstalled, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                    <ui:Button
                                        Style="{StaticResource RowButton}"
                                        Appearance="Primary"
                                        Command="{markup:RowCommand InstallPackageCommand}"
                                        CommandParameter="{Binding}"
                                        Content="{markup:Tr ProjectDetail.Add}"
                                        Visibility="{Binding CanAdd, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                </StackPanel>
                            </Grid>
                            </ui:Card>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

            <Expander Margin="{StaticResource Gap.Large}" Header="{markup:Tr ProjectDetail.UnityArguments}">
                <StackPanel Margin="{StaticResource Gap.Small}">
                    <TextBox
                        MinHeight="52"
                        AcceptsReturn="True"
                        Text="{Binding UnityArgumentsText, UpdateSourceTrigger=PropertyChanged}"
                        TextWrapping="Wrap"
                        VerticalScrollBarVisibility="Auto" />
                    <TextBlock
                        Margin="{StaticResource Gap.Small}"
                        Style="{StaticResource Caption}"
                        Text="{markup:Tr ProjectDetail.UnityArgumentsHint}" />
                </StackPanel>
            </Expander>
        </StackPanel>
    </ScrollViewer>
</UserControl>
