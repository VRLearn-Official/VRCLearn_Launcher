<UserControl
    x:Class="VRCLearn.App.Views.ProjectsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:markup="clr-namespace:VRCLearn.App.Markup"
    xmlns:views="clr-namespace:VRCLearn.App.Views">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="32,40,32,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Grid Grid.Column="0" Margin="0,0,12,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" MinWidth="160" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <ui:TextBox
                        Grid.Column="0"
                        ClearButtonEnabled="True"
                        PlaceholderText="{markup:Tr Projects.Search}"
                        Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" />
                    <ComboBox
                        Grid.Column="1"
                        MinWidth="110"
                        Margin="{StaticResource Gap.Inline}"
                        DisplayMemberPath="Display"
                        ItemsSource="{Binding SortingKeys}"
                        SelectedValue="{Binding SortingKey}"
                        SelectedValuePath="Value"
                        ToolTip="{markup:Tr Projects.Sort}" />
                    <ComboBox
                        Grid.Column="2"
                        MinWidth="80"
                        Margin="{StaticResource Gap.Inline}"
                        DisplayMemberPath="Display"
                        ItemsSource="{Binding SortingDirections}"
                        SelectedValue="{Binding SortingDirection}"
                        SelectedValuePath="Value" />
                    <ui:ProgressRing
                        Grid.Column="3"
                        Margin="12,0,0,0"
                        Style="{StaticResource BusyRing}" />
                </Grid>

                <StackPanel
                    Grid.Column="1"
                    VerticalAlignment="Center"
                    Orientation="Horizontal">
                    <ui:Button
                        Style="{StaticResource ToolbarButton}"
                        Appearance="Secondary"
                        Command="{Binding RefreshCommand}"
                        Content="{markup:Tr Projects.Refresh}" />
                    <ui:Button
                        Style="{StaticResource ToolbarButton}"
                        Appearance="Secondary"
                        Click="OnAddClick"
                        Content="{markup:Tr Projects.Add}" />
                    <ui:Button
                        Margin="0"
                        Style="{StaticResource ToolbarButton}"
                        Appearance="Primary"
                        Command="{Binding NewProjectCommand}"
                        Content="{markup:Tr Projects.New}" />
                </StackPanel>
            </Grid>

        <StackPanel Grid.Row="1" Margin="32,16,32,0">
            <TextBlock
                Style="{StaticResource Caption}"
                Text="{markup:Tr Projects.Empty}"
                Visibility="{Binding HasProjects, Converter={StaticResource InverseBooleanToVisibilityConverter}}" />

            <TextBlock
                Style="{StaticResource Caption}"
                Text="{markup:Tr Projects.SearchEmpty}"
                Visibility="{Binding IsSearchEmpty, Converter={StaticResource BooleanToVisibilityConverter}}" />
        </StackPanel>

        <ItemsControl
            Grid.Row="2"
            Padding="32,16,32,32"
            Style="{StaticResource VirtualizedItems}"
            ItemsSource="{Binding FilteredProjects}">
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <ui:Card
                        Cursor="Hand"
                        MouseLeftButtonUp="OnRowClick"
                        Style="{StaticResource RowCard}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <ui:Button
                                Grid.Column="0"
                                VerticalAlignment="Center"
                                Appearance="Transparent"
                                Command="{markup:RowCommand ToggleFavoriteCommand}"
                                CommandParameter="{Binding}"
                                ToolTip="{Binding FavoriteAction}">
                                <ui:Button.Style>
                                    <Style BasedOn="{StaticResource RowButton}" TargetType="ui:Button">
                                        <Setter Property="Margin" Value="0,0,10,0" />
                                        <Setter Property="Padding" Value="6,0" />
                                        <Setter Property="BorderThickness" Value="0" />
                                        <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsFavorite}" Value="True">
                                                <Setter Property="Foreground" Value="{DynamicResource AccentTextFillColorPrimaryBrush}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </ui:Button.Style>
                                <ui:SymbolIcon
                                    Filled="{Binding IsFavorite}"
                                    FontSize="{StaticResource IconSize.Inline}"
                                    Symbol="Star24" />
                            </ui:Button>

                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Style="{StaticResource RowTitle}" Text="{Binding Name}" />
                                    <ui:SymbolIcon
                                        Margin="8,0,0,0"
                                        FontSize="{StaticResource IconSize.Inline}"
                                        Foreground="{DynamicResource SystemFillColorCautionBrush}"
                                        Symbol="Warning24"
                                        ToolTip="{Binding Summary}"
                                        Visibility="{Binding IsUnreadable, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                </StackPanel>

                                <StackPanel Margin="{StaticResource Gap.Tight}" Orientation="Horizontal">
                                    <ui:SymbolIcon
                                        Margin="0,0,6,0"
                                        VerticalAlignment="Center"
                                        FontSize="{StaticResource IconSize.Inline}"
                                        Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                        Symbol="{Binding TypeIcon}" />
                                    <TextBlock Style="{StaticResource Caption}" Text="{Binding MetaLine}" />
                                </StackPanel>

                                <TextBlock
                                    Margin="0,2,0,0"
                                    Style="{StaticResource CaptionDim}"
                                    Text="{Binding ProjectPath}" />
                            </StackPanel>

                            <StackPanel Grid.Column="2" Style="{StaticResource RowActions}">
                                <views:UnityActionButton
                                    ButtonFocusable="False"
                                    ButtonStyle="{StaticResource RowUnityButton}"
                                    BringToFrontCommand="{markup:RowCommand BringUnityToFrontCommand}"
                                    CommandParameter="{Binding}"
                                    IsUnityRunning="{Binding IsUnityRunning}"
                                    LaunchCommand="{markup:RowCommand LaunchUnityCommand}" />
                                <ui:Button
                                    Style="{StaticResource RowButton}"
                                    Appearance="Secondary"
                                    Command="{markup:RowCommand BackupCommand}"
                                    CommandParameter="{Binding}"
                                    Content="{markup:Tr ProjectDetail.Backup}" />

                                <ui:Button
                                    Style="{StaticResource RowButton}"
                                    Appearance="Secondary"
                                    Click="OnMoreClick"
                                    ContextMenuOpening="OnMoreMenuOpening"
                                    Content="⋯"
                                    ToolTip="{markup:Tr Projects.More}">
                                    <ui:Button.ContextMenu>
                                        <ContextMenu>
                                            <MenuItem Click="OnOpenFolderClick" Header="{markup:Tr Projects.OpenFolder}" />
                                            <MenuItem Click="OnRenameClick" Header="{markup:Tr Projects.Rename}" />
                                            <MenuItem Click="OnRemoveClick" Header="{markup:Tr Projects.Remove}" />
                                        </ContextMenu>
                                    </ui:Button.ContextMenu>
                                </ui:Button>
                            </StackPanel>
                        </Grid>
                    </ui:Card>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
    </Grid>
</UserControl>
