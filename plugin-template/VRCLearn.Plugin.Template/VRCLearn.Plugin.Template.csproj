<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <AssemblyName>VRCLearn.Plugin.Template</AssemblyName>
    <RootNamespace>VRCLearn.Plugin.Template</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="WPF-UI" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\VRCLearn.Plugin.Sdk\VRCLearn.Plugin.Sdk.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Update="plugin.json" CopyToOutputDirectory="PreserveNewest" />
    <None Update="localization\*.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
